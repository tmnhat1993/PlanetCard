{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enemy.schema.json",
  "title": "EnemyData",
  "type": "object",
  "required": ["id", "name", "role", "faction", "max_hp", "actions"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "name": {"type": "string"},
    "role": {"enum": ["STRIKER", "TANK", "SUPPORT", "CONTROLLER", "SUMMONER", "PREDATOR", "ELITE", "BOSS"]},
    "faction": {"type": "string"},
    "max_hp": {"type": "integer", "minimum": 1},
    "initiative": {"type": "integer", "default": 0},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "effects"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "weight": {"type": "integer", "minimum": 0},
          "no_repeat_more_than": {"type": "integer", "minimum": 1},
          "condition": {"$ref": "condition.schema.json"},
          "effects": {"type": "array", "minItems": 1, "items": {"$ref": "effect.schema.json"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
