{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "encounter.schema.json",
  "title": "EncounterData",
  "type": "object",
  "required": ["id", "planet_id", "enemy_slots", "reward_id"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "planet_id": {"type": "string"},
    "stage": {"type": "integer", "minimum": 1},
    "enemy_slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slot", "enemy_id"],
        "properties": {
          "slot": {"type": "integer", "minimum": 0},
          "enemy_id": {"type": "string"},
          "level": {"type": "integer", "minimum": 1, "default": 1}
        },
        "additionalProperties": false
      }
    },
    "field_id": {"type": ["string", "null"]},
    "reward_id": {"type": "string"},
    "intel_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
