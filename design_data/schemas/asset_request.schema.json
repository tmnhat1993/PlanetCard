{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset_request.schema.json",
  "title": "AssetRequest",
  "type": "object",
  "required": [
    "request_version", "asset_id", "feature", "asset_type", "gameplay_role",
    "source_size", "display_size", "priority", "status", "acceptance"
  ],
  "properties": {
    "request_version": {"type": "integer", "minimum": 1},
    "asset_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "feature": {"type": "string"},
    "asset_type": {"type": "string"},
    "faction": {"type": ["string", "null"]},
    "gameplay_role": {"type": "string"},
    "source_size": {"$ref": "#/$defs/size"},
    "display_size": {"$ref": "#/$defs/size"},
    "camera": {"type": "string"},
    "direction": {"type": "string"},
    "required_states": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "priority": {"enum": ["P0", "P1", "P2", "P3"]},
    "status": {"enum": ["BRIEF", "GENERATING", "GENERATED", "REVIEW", "REVISION", "APPROVED", "IMPORTED", "IN_GAME_QA", "LOCKED"]},
    "brief_path": {"type": "string"},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "size": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
